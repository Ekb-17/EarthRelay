# Optional Mapbox public token. Leave empty to use OpenFreeMap (no key required).
VITE_MAPBOX_TOKEN=

# Gemini Flash (Google AI Studio). Used to read the photo for type and severity.
GEMINI_API_KEY=

# Optional. Cases + photos sync here so phone and laptop share one inbox.
# URL + publishable: Project Settings → API
# SECRET: Project Settings → Database → URI (starts with postgresql://)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional SMTP for volunteer invitations. Leave empty to save invites without sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=https://localhost:5173
ORG_NAME=EarthRelay Response Team
