# Optional Mapbox public token. Leave empty to use OpenFreeMap (no key required).
VITE_MAPBOX_TOKEN=

# Email delivery for invites and password-reset codes.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use a Google App Password for SMTP_PASSWORD (not your normal Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORG_NAME=EarthRelay Response Team
